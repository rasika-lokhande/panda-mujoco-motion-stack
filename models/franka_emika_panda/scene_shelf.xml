<mujoco model="panda scene">
  <include file="panda_nohand_grav.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="obstacle">
      <geom type="box" contype="1" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Tall divider splitting the workspace into left (+y) and right (-y) zones: crossing it means going over the top -->
    <body name="divider" pos="0.50 0.08 0.225">
      <geom class="obstacle" size="0.25 0.015 0.225" rgba="0.85 0.55 0.2 1"/>
    </body>

    <!-- Two-slot shelf on the robot's right (-y), open side facing the robot -->
    <body name="shelf" pos="0.38 -0.48 0">
      <geom name="shelf_back"   class="obstacle" pos="0 -0.125 0.365" size="0.18 0.005 0.365" rgba="0.55 0.4 0.3 1"/>
      <geom name="shelf_side_l" class="obstacle" pos="-0.18 0 0.365"  size="0.01 0.13 0.365"  rgba="0.55 0.4 0.3 1"/>
      <geom name="shelf_side_r" class="obstacle" pos="0.18 0 0.365"   size="0.01 0.13 0.365"  rgba="0.55 0.4 0.3 1"/>
      <geom name="shelf_board_low" class="obstacle" pos="0 0 0.16"    size="0.18 0.13 0.01"  rgba="0.65 0.5 0.35 1"/>
      <geom name="shelf_board_mid" class="obstacle" pos="0 0 0.44"    size="0.18 0.13 0.01"  rgba="0.65 0.5 0.35 1"/>
      <geom name="shelf_board_top" class="obstacle" pos="0 0 0.72"    size="0.18 0.13 0.01"  rgba="0.65 0.5 0.35 1"/>
    </body>
  </worldbody>
</mujoco>
